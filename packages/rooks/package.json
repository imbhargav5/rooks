{
  "name": "rooks",
  "version": "9.9.1",
  "description": "Collection of awesome react hooks",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "typings": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./experimental": {
      "types": "./dist/esm/experimental.d.ts",
      "import": "./dist/esm/experimental.js",
      "default": "./dist/esm/experimental.js"
    },
    "./temporal": {
      "types": "./dist/esm/temporal.d.ts",
      "import": "./dist/esm/temporal.js",
      "default": "./dist/esm/temporal.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "homepage": "https://rooks.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imbhargav5/rooks.git"
  },
  "bugs": "https://github.com/imbhargav5/rooks/issues",
  "scripts": {
    "clean": "rimraf dist lib",
    "commit": "cz",
    "lint": "eslint src/**/*.ts",
    "format": "pnpm run prettier --write \"./src/*.+(js|jsx|ts|tsx)\" && pnpm run prettier --write \"./docs/*.+(md|mdxx)\"",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run 2>&1 | tee /tmp/vitest-output.log; grep 'Test Files' /tmp/vitest-output.log | grep -qv 'failed'",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "check:dist": "es-check",
    "check:size": "size-limit --highlight-less",
    "check:package": "publint --pack npm --strict && attw --pack --profile esm-only",
    "check:package-guarantees": "pnpm build && pnpm check:dist && pnpm check:size && pnpm check:package",
    "sanity-check": "npx tsx scripts/sanity-check-all.ts",
    "sanity:types": "npx tsx scripts/sanity-check-types.ts",
    "sanity:imports": "npx tsx scripts/sanity-check-imports.ts",
    "sanity:eslint": "npx tsx scripts/sanity-check-eslint.ts",
    "coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage 2>&1 | tee /tmp/vitest-coverage.log; grep 'Test Files' /tmp/vitest-coverage.log | grep -qv 'failed'",
    "prebuild": "rimraf dist",
    "build": "node build.js",
    "test-ct": "playwright test -c playwright-ct.config.ts",
    "tsc": "tsc --noEmit",
    "test-hooks": "NODE_OPTIONS=--no-experimental-webstorage vitest run 2>&1 | tee /tmp/vitest-hooks.log; grep 'Test Files' /tmp/vitest-hooks.log | grep -qv 'failed'"
  },
  "optionalDependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "lodash.debounce": "^4.0.8",
    "raf": "^3.4.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/plugin-external-helpers": "7.27.1",
    "@babel/plugin-proposal-export-default-from": "7.27.1",
    "@babel/plugin-proposal-unicode-property-regex": "^7.18.6",
    "@babel/preset-env": "7.29.14",
    "@babel/preset-react": "7.29.7",
    "@react-types/shared": "^3.37.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@size-limit/file": "^12.1.0",
    "@size-limit/webpack": "^12.1.0",
    "@size-limit/webpack-why": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/lodash": "^4.17.27",
    "@types/lodash.debounce": "^4.0.9",
    "@types/raf": "^3.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@widgetbot/embed-api": "^1.2.18",
    "@widgetbot/react-embed": "^1.11.3",
    "all-contributors-cli": "^6.26.1",
    "assert": "^2.1.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "10.1.1",
    "babel-plugin-prismjs": "2.1.0",
    "babel-preset-minify": "0.5.2",
    "camel-case": "^5.0.0",
    "chalk": "5.6.2",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "conventional-changelog-cli": "^5.0.0",
    "cz-conventional-changelog": "3.3.0",
    "es-check": "^9.9.0",
    "es-main": "^1.4.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-d.ts": "^1.3.1",
    "eslint": "^9.39.5",
    "execa": "^9.6.1",
    "fake-indexeddb": "^6.2.8",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.6",
    "gulp": "^5.0.1",
    "gulp-conventional-changelog": "^5.0.0",
    "husky": "^9.1.7",
    "inquirer": "13.3.0",
    "jsdom": "^29.1.1",
    "lodash.capitalize": "4.2.1",
    "lodash.sortby": "^4.7.0",
    "lodash.truncate": "^4.4.2",
    "make-dir": "5.1.0",
    "mdast-normalize-headings": "^4.0.0",
    "mdast-util-compact": "^5.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-heading-range": "^4.0.0",
    "mdast-util-to-markdown": "^2.2.3",
    "mdast-zone": "^6.1.0",
    "meow": "14.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "np": "^11.2.2",
    "ora": "9.3.0",
    "pkg-dir": "^9.0.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "read-pkg-up": "11.0.0",
    "readline-sync": "^1.4.10",
    "remark": "^15.0.1",
    "remark-behead": "^3.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-preset-lint-markdown-style-guide": "^6.0.1",
    "remark-strip-badges": "^7.0.0",
    "rimraf": "^6.1.4",
    "size-limit": "^12.1.0",
    "terser": "^5.51.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig": "^7.0.0",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-find": "^3.0.0",
    "unist-util-find-all-after": "^5.0.0",
    "unist-util-find-all-before": "^5.0.0",
    "unist-util-find-all-between": "^2.1.0",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "vfile-reporter": "^8.1.1",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "webpack": "5.112.2",
    "webpack-cli": "^7.3.1",
    "wsrun": "^5.2.4",
    "yargs": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "react",
    "hooks",
    "custom",
    "custom-hooks",
    "typescript",
    "react-hooks"
  ],
  "publishConfig": {
    "access": "public"
  }
}
